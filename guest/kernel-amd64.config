CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_RTC_DRV_CMOS=y
# LZ4 decompresses several times faster than the default gzip at boot
CONFIG_KERNEL_LZ4=y
# PVH entry point: lets Cloud Hypervisor / Firecracker boot the uncompressed
# vmlinux directly (evaluation, docs/benchmarks/09-*)
CONFIG_PVH=y
