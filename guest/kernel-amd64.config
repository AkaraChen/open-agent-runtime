# Applied after kernel.config. The guest is a VM with virtio devices, a serial
# console and ACPI/PCI discovery, so what the x86_64 defconfig carries for
# real hardware, kernel debugging and features oar does not use is switched
# off below. PERF: every driver costs boot time in its initcall and device
# probe, and each access to an emulated register is a VM exit (tens of
# microseconds when the host is itself a VM, as on CI). Dropped:
#   debugging   DEBUG_WX (walks all page tables before init), DEBUG_ENTRY,
#               DEBUG_MEMORY_INIT, DEBUG_FS, tracing and kprobes (a boot-time
#               tracefs setup), CGROUP_DEBUG
#   entropy     jitterentropy (7-12 ms of timing loops in jent_mod_init) is
#               only built for the DRBG that IPsec ESP drags in; with IPsec
#               gone the guest has RDRAND and virtio-rng
#   security    SELinux and AUDIT: the OCI spec has no labels, and runc needs
#               neither (mmap_min_addr keeps the value SELinux used to set)
#   network     NICs other than virtio-net (E1000 and friends), PHYLIB,
#               netconsole, in-kernel IP autoconfig, rfkill, IPv6 tunnels
#   input       keyboard, mouse, i8042, HID, PC speaker, VGA text console,
#               I2C: the console is serial (or virtio-console)
#   storage     SCSI, MD/DM, partition tables, preallocated loop devices: the
#               data disk is a raw virtio-blk device
#   power       suspend, hibernation, cpufreq, ACPI battery/AC/button/fan/
#               thermal/video, hwmon, RAPL and the other hardware counters
#   platform    machine-check, /dev/{cpu/*/msr,cpuid,mem,port}, RTC driver
#               (the clock comes from kvm-clock or the CMOS read at boot),
#               ACPI PM timer, HPET device, PTP, watchdog, IOMMUs, kexec,
#               legacy buses, the 0x80 port delay, 3 of the 4 UARTs and the
#               PCI UART probes
# Kept on purpose: everything runc and CRIU need (kernel.config), netfilter and
# bridge/veth, loop, FUSE, KASLR, CPU idle/haltpoll, ACPI and PCI (power-off,
# virtio-pci, and the PNP UART: microvm wires COM1 to an IOAPIC pin only ACPI
# knows, the legacy IRQ 4 never fires), HZ=1000 (jiffy timers stay fine).
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
# LZ4 decompresses several times faster than the default gzip at boot
CONFIG_KERNEL_LZ4=y
# PVH entry point: lets Cloud Hypervisor / Firecracker boot the uncompressed
# vmlinux directly (evaluation, docs/benchmarks/09-*)
CONFIG_PVH=y

# most of the options below only show up with EXPERT (it changes no value)
CONFIG_EXPERT=y

# debugging
CONFIG_DEBUG_WX=n
CONFIG_DEBUG_ENTRY=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_DEBUG_STACK_USAGE=n
CONFIG_DEBUG_MISC=n
CONFIG_DEBUG_DEVRES=n
CONFIG_DEBUG_BOOT_PARAMS=n
CONFIG_PNP_DEBUG_MESSAGES=n
CONFIG_PM_DEBUG=n
CONFIG_CGROUP_DEBUG=n
# PERF: no debugfs, tracefs or kprobes in the guest: perf, bpftrace and
# trace-cmd need a kernel built with them (reinstate FTRACE, KPROBES, UPROBES
# and DEBUG_FS to profile inside the guest)
CONFIG_DEBUG_FS=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_PROFILING=n

# entropy: IPv6 AH/ESP are the only users of the IV generators that select
# the DRBG, which selects jitterentropy (PERF: gives up IPv6 IPsec; IPv4 AH and
# ESP were never built in)
CONFIG_INET6_AH=n
CONFIG_INET6_ESP=n
CONFIG_XFRM_USER=n
CONFIG_CRYPTO_GCM=n
CONFIG_CRYPTO_SEQIV=n
CONFIG_CRYPTO_ECHAINIV=n
CONFIG_CRYPTO_DRBG_MENU=n
CONFIG_CRYPTO_JITTERENTROPY=n

# security: no mandatory access control or audit trail (PERF: a workload that
# needs SELinux, AppArmor or auditd needs another kernel)
CONFIG_AUDIT=n
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY=n
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

# network
CONFIG_ETHERNET=n
CONFIG_PHYLIB=n
CONFIG_FIXED_PHY=n
CONFIG_REALTEK_PHY=n
CONFIG_NETCONSOLE=n
CONFIG_IP_PNP=n
CONFIG_IPV6_SIT=n
CONFIG_RFKILL=n

# input and video
CONFIG_INPUT=n
CONFIG_SERIO=n
CONFIG_HID=n
CONFIG_VT=n
CONFIG_I2C=n
CONFIG_PCSPKR_PLATFORM=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_NEW_LEDS=n

# storage
CONFIG_SCSI=n
CONFIG_MD=n
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=n
CONFIG_EFI_PARTITION=n
# loop devices are created on demand through /dev/loop-control
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_ZSTD=n

# power management
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_SCHED_MC_PRIO=n
CONFIG_CPU_FREQ=n
CONFIG_ACPI_AC=n
CONFIG_ACPI_BATTERY=n
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_FAN=n
CONFIG_ACPI_DOCK=n
CONFIG_ACPI_THERMAL=n
CONFIG_ACPI_VIDEO=n
CONFIG_ACPI_WMI=n
CONFIG_ACPI_BGRT=n
CONFIG_HWMON=n
CONFIG_POWER_SUPPLY=n
CONFIG_PERF_EVENTS_INTEL_RAPL=n
CONFIG_PERF_EVENTS_INTEL_UNCORE=n
CONFIG_PERF_EVENTS_INTEL_CSTATE=n
CONFIG_PERF_EVENTS_AMD_UNCORE=n

# platform
# no outb to port 0x80 after legacy I/O (a VM exit each)
CONFIG_IO_DELAY_0X80=n
CONFIG_IO_DELAY_NONE=y
CONFIG_X86_MCE=n
CONFIG_X86_MSR=n
CONFIG_X86_CPUID=n
CONFIG_X86_PM_TIMER=n
CONFIG_X86_CHECK_BIOS_CORRUPTION=n
CONFIG_X86_EXTENDED_PLATFORM=n
CONFIG_X86_PLATFORM_DEVICES=n
CONFIG_IOSF_MBI=n
CONFIG_IOMMU_SUPPORT=n
CONFIG_HPET=n
# PERF: no RTC class device, so no /dev/rtc0 or hwclock; the wall clock is
# still set at boot (kvm-clock, or the CMOS read the architecture code does)
CONFIG_RTC_CLASS=n
CONFIG_HOTPLUG_PCI=n
CONFIG_PCIEASPM=n
CONFIG_PCCARD=n
CONFIG_AGP=n
CONFIG_INTEL_MEI=n
CONFIG_PTP_1588_CLOCK=n
CONFIG_PPS=n
CONFIG_WATCHDOG=n
CONFIG_DMADEVICES=n
CONFIG_DMIID=n
CONFIG_FIRMWARE_MEMMAP=n
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_NVRAM=n
CONFIG_HW_RANDOM_VIA=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n

# serial: one UART at 0x3f8, no probing for the rest
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_8250_EXTENDED=n
CONFIG_SERIAL_8250_PCI=n
CONFIG_SERIAL_8250_DMA=n
CONFIG_SERIAL_8250_EXAR=n
CONFIG_SERIAL_8250_DWLIB=n
CONFIG_SERIAL_8250_LPSS=n
CONFIG_SERIAL_8250_MID=n
CONFIG_SERIAL_8250_PERICOM=n
