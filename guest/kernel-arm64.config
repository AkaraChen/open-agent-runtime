# Applied after kernel.config. The guest is a VM with virtio devices, a serial
# console and device-tree discovery (QEMU virt, Virtualization.framework), so
# what the arm64 defconfig carries for SoCs, real hardware and kernel
# debugging is switched off below. PERF: every driver costs boot time in its
# initcall, and the defconfig builds in hundreds of SoC drivers (pinctrl, clk,
# regulator, I2C, SPI, MMC, PHY...). Dropped, by analogy with kernel-amd64.config:
#   platforms   every vendor SoC (ARCH_*): their drivers depend on them
#   debugging   DEBUG_FS, DEBUG_MEMORY_INIT
#   entropy     jitterentropy and the DRBG, only selected through IPv6 AH/ESP
#   security    AUDIT, SELinux, the security framework (mmap_min_addr keeps 65536)
#   network     NICs other than virtio-net, PHYLIB, in-kernel IP autoconfig
#   input/disk  keyboard/mouse/HID/VT, I2C, SPI, MMC, SCSI, MD, partition tables
#   power       suspend, hibernation, cpufreq, hwmon, kexec, KVM host, Xen, IOMMUs
# Kept on purpose: everything runc and CRIU need (kernel.config), GIC, the arch
# timer, PL011, the PL031 RTC, PCI, netfilter, FUSE, KASLR, ACPI.
# This fragment is verified only under QEMU virt (TCG); Virtualization.framework
# on Apple Silicon cannot be tested on hosted runners.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y

# most of the options below only show up with EXPERT (it changes no value)
CONFIG_EXPERT=y

# platforms
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# debugging
CONFIG_DEBUG_FS=n
CONFIG_DEBUG_MEMORY_INIT=n

# entropy
CONFIG_INET6_AH=n
CONFIG_INET6_ESP=n
CONFIG_CRYPTO_GCM=n
CONFIG_CRYPTO_SEQIV=n
CONFIG_CRYPTO_ECHAINIV=n
CONFIG_CRYPTO_USER_API_RNG=n
CONFIG_CRYPTO_HW=n
CONFIG_CRYPTO_ECDH=n
CONFIG_CRYPTO_DH=n
CONFIG_CRYPTO_DRBG_MENU=n
CONFIG_CRYPTO_JITTERENTROPY=n

# security
CONFIG_AUDIT=n
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY=n
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

# network
CONFIG_ETHERNET=n
CONFIG_NET_DSA=n
# the PHY drivers select PHYLIB; as modules they are not built
CONFIG_PHYLIB=m
CONFIG_IP_PNP=n
CONFIG_IPV6_SIT=n
CONFIG_RFKILL=n

# input, buses and storage
CONFIG_INPUT=n
CONFIG_SERIO=n
CONFIG_HID=n
CONFIG_VT=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MMC=n
CONFIG_SCSI=n
CONFIG_MD=n
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=n
CONFIG_EFI_PARTITION=n
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0

# power and platform
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_FREQ=n
CONFIG_HWMON=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_IOMMU_SUPPORT=n
CONFIG_WATCHDOG=n
CONFIG_PTP_1588_CLOCK=n
CONFIG_DMADEVICES=n
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
